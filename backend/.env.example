# Backend Environment Variables

# ======================
# Logging Configuration
# ======================
LOG_LEVEL=INFO           # DEBUG, INFO, WARNING, ERROR
LOG_FORMAT=pretty        # json or pretty

# Dispatcharr API URL (internal network)
DISPATCHARR_URL=http://10.10.10.10:9191
# Personal API key from the Dispatcharr profile page (0.20.0+), sent as
# "Authorization: ApiKey <key>". Required for channel groups and stream stats.
DISPATCHARR_API_KEY=

# Dispatcharr Authentication (optional - for Status tab stream stats)
# DISPATCHARR_USERNAME=your_dispatcharr_username
# DISPATCHARR_PASSWORD=your_dispatcharr_password

# JWT signing key is required even when login methods are disabled.
# Generate at least 32 random characters: openssl rand -hex 32
JWT_SECRET=dev-secret-change-in-production

# ======================
# Authentication Settings
# ======================

# Feature Flags (both default to false)
# At least one should be enabled for the app to be usable
LOCAL_AUTH_ENABLED=true        # Enable username/password authentication
PLEX_AUTH_ENABLED=false        # Enable Plex OAuth authentication

# Local Auth Credentials (only used when LOCAL_AUTH_ENABLED=true)
# Blank/unset passwords disable that account. Set unique passwords before login.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
VIEWER_USERNAME=viewer
VIEWER_PASSWORD=

# Plex Auth Settings (only used when PLEX_AUTH_ENABLED=true)
# PLEX_SERVER_TOKEN=             # Your Plex server token
# PLEX_SERVER_MACHINE_ID=        # Your Plex server machine identifier
# PLEX_DEFAULT_ROLE=viewer       # Default role for Plex users (viewer or admin)
# PLEX_ADMIN_USERS_STR=          # Comma-separated Plex usernames who get admin role

# ErsatzTV Configuration
# M3U playlist URL for channel list
ERSATZTV_M3U_URL=http://192.168.50.108:8409/iptv/channels.m3u8
# XMLTV URL for programme guide data
ERSATZTV_XMLTV_URL=http://192.168.50.108:8409/iptv/xmltv.xml
# Base URL for ErsatzTV server
ERSATZTV_BASE_URL=http://192.168.50.108:8409

# ======================
# Chat Feature (Optional)
# ======================
# Enable real-time chat between connected users
# CHAT_ENABLED=false

# ======================
# GIF Feature (Optional)
# ======================
# Enable GIF picker in chat using Giphy API
# Requires chat to be enabled
# Get API key from: https://developers.giphy.com/
# GIPHY_API_KEY=your-giphy-api-key-here

# ======================
# Chromecast Feature (Optional)
# ======================
# Enable casting streams to Chromecast devices
# Requires FFmpeg in the container for MPEG-TS to HLS transcoding
# CAST_ENABLED=false
# CAST_HLS_SEGMENT_TIME=4      # Seconds per HLS segment
# CAST_HLS_LIST_SIZE=5         # Number of segments in playlist
# CAST_TEMP_DIR=/tmp/cast_hls  # Temp storage for HLS segments
# CAST_SESSION_TIMEOUT=300     # Seconds without activity before cleanup
