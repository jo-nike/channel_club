# IPTV Viewer Configuration
# Copy this file to .env and fill in your values
#
# Usage:
#   cp .env.example .env
#   # Edit .env with your actual values
#   docker-compose up -d --build

# ======================
# Logging Configuration
# ======================
LOG_LEVEL=INFO           # DEBUG, INFO, WARNING, ERROR
LOG_FORMAT=pretty        # json or pretty

# Frontend Logging
# Valid values: debug, info, warn, error
# Default: debug in development, warn in production
VITE_LOG_LEVEL=debug

# ===================
# Backend Configuration
# ===================

# Dispatcharr API URL (via Wireguard VPN)
# This is the internal IP of your VPS running Dispatcharr
DISPATCHARR_URL=http://10.10.10.10:9191

# Dispatcharr Authentication (optional - for Status tab stream stats)
# DISPATCHARR_USERNAME=your_dispatcharr_username
# DISPATCHARR_PASSWORD=your_dispatcharr_password

# JWT Secret Key - CHANGE THIS IN PRODUCTION!
# Generate with: openssl rand -hex 32
JWT_SECRET=your-secret-key-change-me

# Stream base URL - where Dispatcharr streams are exposed externally
# Replace domain.com with your actual domain
STREAM_BASE_URL=https://streams.domain.com

# ======================
# Authentication Settings
# ======================

# Feature Flags (both default to false)
# IMPORTANT: At least one must be enabled for authentication to work!
LOCAL_AUTH_ENABLED=true        # Enable username/password authentication
PLEX_AUTH_ENABLED=false        # Enable Plex OAuth authentication

# Local Auth Credentials (only used when LOCAL_AUTH_ENABLED=true)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your-secure-admin-password
VIEWER_USERNAME=viewer
VIEWER_PASSWORD=your-secure-viewer-password

# Plex Auth Settings (only used when PLEX_AUTH_ENABLED=true)
# PLEX_SERVER_TOKEN=             # Your Plex server token
# PLEX_SERVER_MACHINE_ID=        # Your Plex server machine identifier
# PLEX_DEFAULT_ROLE=viewer       # Default role for Plex users (viewer or admin)
# PLEX_ADMIN_USERS_STR=              # Comma-separated Plex usernames who get admin role

# ===================
# Frontend Configuration (Build-time)
# ===================
# Note: These are compiled into the frontend during docker build.
# For production, the defaults below work with same-origin deployment.

# API URL - relative path for same-origin requests
# Default works for production when frontend is served from backend
VITE_API_URL=/api

# WebSocket URL - full URL for production
# Replace iptv.domain.com with your actual domain
VITE_WS_URL=wss://iptv.domain.com/api/ws

# Stream base URL for frontend - should match STREAM_BASE_URL above
# Replace domain.com with your actual domain
VITE_STREAM_BASE_URL=https://streams.domain.com
