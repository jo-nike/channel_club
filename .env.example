# IPTV Viewer Configuration
# Copy this file to .env and fill in your values
#
# Usage:
#   cp .env.example .env
#   # Edit .env with your actual values
#   docker-compose up -d --build

# ===================
# Backend Configuration
# ===================

# Dispatcharr API URL (via Wireguard VPN)
# This is the internal IP of your VPS running Dispatcharr
# Example: http://10.8.0.2:9191
DISPATCHARR_URL=http://10.8.0.2:9191

# Stream base URL - where Dispatcharr streams are exposed externally
# Replace domain.com with your actual domain
STREAM_BASE_URL=https://streams.domain.com

# JWT Secret Key - CHANGE THIS IN PRODUCTION!
# Generate with: openssl rand -hex 32
JWT_SECRET=your-secret-key-change-me

# Admin Credentials - Full access to channel control
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password

# Viewer Credentials - Read-only access, follows admin selection
VIEWER_USERNAME=viewer
VIEWER_PASSWORD=change-this-password

# ===================
# Frontend Configuration (Build-time)
# ===================
# Note: These are compiled into the frontend during docker build.
# For production, the defaults below work with same-origin deployment.

# API URL - relative path for same-origin requests
# Default works for production when frontend is served from backend
VITE_API_URL=/api

# WebSocket URL - full URL for production
# Replace iptv.domain.com with your actual domain
VITE_WS_URL=wss://iptv.domain.com/api/ws

# Stream base URL for frontend - should match STREAM_BASE_URL above
# Replace domain.com with your actual domain
VITE_STREAM_BASE_URL=https://streams.domain.com
