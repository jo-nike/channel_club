# Frontend Environment Variables
# Optional: defaults to the application origin through the Vite /api proxy.
VITE_API_URL=/api
# WebSockets also use the current browser origin; no VITE_WS_URL is needed.
# Optional absolute receiver-reachable API origin for Chromecast:
# VITE_CAST_BASE_URL=http://your-server:8001/api

# Frontend Logging
# Valid values: debug, info, warn, error
# Default: debug in development, warn in production
VITE_LOG_LEVEL=debug

# Chat Feature
# Set to 'true' to enable chat functionality (requires backend CHAT_ENABLED=true)
VITE_CHAT_ENABLED=true

# GIF Feature
# Set to 'true' to enable GIF picker in chat (requires backend GIPHY_API_KEY to be set)
VITE_GIF_ENABLED=true
